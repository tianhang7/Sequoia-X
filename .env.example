# 数据库路径（默认：data/sequoia_v2.db）
DB_PATH=data/sequoia_v2.db

# 数据起始日期（默认：2024-01-01）
START_DATE=2024-01-01

# 推送配置：默认使用 Telegram（不填 Token/Chat ID 则跳过推送）
# 机器人 Token（通过 @BotFather 获取）
TELEGRAM_BOT_TOKEN=
# 接收消息的 Chat ID（用户/群组/频道 ID，群组通常为负数，如 -100xxxxxxxxxx）
TELEGRAM_CHAT_ID=
# 自定义反向代理 API 地址（默认官方接口，若服务器在国内访问受限可使用反代）
TELEGRAM_API_BASE=https://api.telegram.org

# ── 以下均可省略，使用默认值 ──
# 数据新鲜度：strict（默认，库内数据落后最新交易日则告警并拒绝推送）/ warn / off
DATA_FRESHNESS=strict
# 选股过滤器：总开关 / 次新股最小K线数 / 20日均成交额下限(元) / 是否剔除信号日涨停
ENABLE_SYMBOL_FILTERS=true
FILTER_MIN_BARS=60
FILTER_MIN_AVG_AMOUNT=100000000
FILTER_DROP_LIMIT_UP=true
# 持仓规则：硬止损比例 / 时间止损天数
POSITION_STOP_LOSS=0.07
POSITION_TIME_STOP_DAYS=10
# 移动止损（默认启用，与回测 --bt-trail-ma 10 --bt-trail-activate 0.05 同口径）：
#   硬止损 > 浮盈超 POSITION_TRAIL_ACTIVATE 后，收盘跌破 MA_N 离场；
#   该模式下 POSITION_TIME_STOP_DAYS 不生效（回测实测：固定10日时间止损会砍掉未兑现的赢家）。
#   设为 0 可回退到「硬止损 > 跌破MA20 > 时间止损」的旧行为。
#   敏感性测试（2025-09-18~2026-09-16）：RPS 剔除最大单笔后收益
#   0.0→+340% / 0.03→+893% / 0.05→+1070% / 0.10→+1168%，四档全正、无过拟合；
#   参数越大胜率越低但均笔越高。若追求更高总收益可上调至 0.10。
POSITION_TRAIL_MA=10
POSITION_TRAIL_ACTIVATE=0.05
# 当日操作手册：止盈目标比例（止盈目标 = 信号日收盘价 × (1 + 该比例)；默认 0.20 即 +20%）
MANUAL_TAKE_PROFIT=0.20
# 当日操作手册 Telegram 摘要：买卖各取前 N 条（默认 10；0 = 不推送摘要，只落盘 Markdown）
MANUAL_PUSH_TOP_N=10
# 原始价同步：是否在增量/回填时同步不复权收盘价 raw_close（可执行价；默认 true，关闭省一半请求）
ENABLE_RAW_PRICES=true
# 运行归档：日志落盘路径（空=仅控制台）/ 每日选股 JSON 归档目录
LOG_FILE=log.txt
SELECTIONS_DIR=data/selections

